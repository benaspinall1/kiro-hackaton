{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "tests/integration.test.ts", "tests/redaction-engine.test.ts", "tests/pii-scanner.property.test.ts", "tests/pii-scanner.test.ts", "tests/pdf-text-extractor.test.ts", "tests/notification-service.test.ts", "tests/ethics-logic-gate.test.ts", "tests/chat-proxy.property.test.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}
